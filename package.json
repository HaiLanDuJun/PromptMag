{
  "name": "prompt-mag",
  "version": "1.2.0",
  "private": true,
  "description": "PromptMag - CLI 提示词弹夹：多图锚定 + Agent 任务队列自动接力",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "electron:dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"vite\" \"wait-on tcp:5199 && set PM_USE_DEV_SERVER=1&& electron .\"",
    "dev:all": "npm run electron:dev",
    "build": "vite build",
    "start": "electron .",
    "dev:static": "npm run build && electron .",
    "preview": "npm run build && electron .",
    "icon": "node scripts/make-icon.cjs",
    "clean": "node -e \"require('node:fs').rmSync('release',{recursive:true,force:true})\"",
    "dist": "npm run clean && npm run build && electron-builder --win",
    "dist:portable": "npm run clean && npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.4.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.hailandujun.promptmag",
    "productName": "PromptMag",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "PromptMag-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "PromptMag-Portable-${version}.${ext}"
    }
  }
}
